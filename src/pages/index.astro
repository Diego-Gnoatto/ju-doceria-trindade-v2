---
import MainLayout from '../layouts/MainLayout.astro';

const WA = "https://wa.me/5562996358321?text=Oi%20Ju!%20Vi%20seu%20site%20e%20quero%20encomendar%20doces";

const SERVICES = [
  { title: "Doces Caseiros", desc: "Brigadeiros, beijinhos, receita da mamae", emoji: "&#127856;", href: "/servicos/doces-caseiros/", rot: "-1deg" },
  { title: "Bolos Artesanais", desc: "Fofinhos com sabor de vovo", emoji: "&#127874;", href: "/servicos/bolos-artesanais/", rot: "0.5deg" },
  { title: "Doces para Festas", desc: "Tabela de quantidades por evento", emoji: "&#127880;", href: "/servicos/doces-para-festas/", rot: "-0.8deg" },
  { title: "Tortas Doces", desc: "Massa crocante, recheio generoso", emoji: "&#129472;", href: "/servicos/tortas-doces/", rot: "1.2deg" },
  { title: "Brigadeiro Gourmet", desc: "Chocolate nobre, sabores variados", emoji: "&#127852;", href: "/servicos/brigadeiro-gourmet/", rot: "-0.5deg" },
  { title: "Aulas de Culinaria", desc: "Aprenda com a Ju em Trindade", emoji: "&#127859;", href: "/aulas/", rot: "0.7deg" },
];

const DEPO = [
  { name: "Maria Aparecida", text: "Os brigadeiros da Ju sao o melhor que ja comi em Trindade. Sabor de verdade.", city: "Trindade, GO", rot: "-2deg" },
  { name: "Carla Mendes", text: "Encomendei para o aniversario, todo mundo elogiou! Recomendo demais.", city: "Goiania, GO", rot: "1.5deg" },
  { name: "Rosa Lima", text: "Fiz a aula de culinaria e aprendi receitas que nunca imaginei.", city: "Trindade, GO", rot: "-1deg" },
];

const FAQS = [
  { q: "Como faco para encomendar?", a: "Clique no WhatsApp e fale direto com a Ju. Seg-Sab, 8h as 18h." },
  { q: "Qual o prazo para encomendas?", a: "Para festas, 3 dias de antecedencia. Pedidos menores: mesmo dia." },
  { q: "Voces entregam em Goiania?", a: "Sim! Trindade, Goiania, Anapolis e Itumbiara." },
  { q: "Os doces sao feitos no dia?", a: "Todos produzidos no dia da entrega, com ingredientes selecionados." },
  { q: "Como funcionam as aulas?", a: "Presenciais em Trindade GO. Turmas pequenas, material incluso." },
  { q: "Formas de pagamento?", a: "Dinheiro, PIX ou cartao na entrega." },
];
---

<MainLayout
  title="Ju dOCERIA - Doces Caseiros em Trindade GO | Encomende pelo WhatsApp"
  description="Doces caseiros com receita da mae em Trindade, GO. Brigadeiros, bolos, tortas e doces para festas. WhatsApp (62) 99635-8321. Aulas de culinaria."
>

  <!-- ===================== HERO ===================== -->
  <section class="hero">
    <div class="hero-bg-ornament"></div>
    <div class="container hero-grid">
      <div class="hero-content">
        <span class="eyebrow">Confeitaria Artesanal em Trindade</span>
        <h1 class="hero-title">
          <span class="word">Doces</span>
          <span class="word">que</span>
          <span class="word"><em>emocionam</em></span>
        </h1>
        <p class="hero-subtitle">Receita da mamae. Ingredientes selecionados. Cada doce feito com amor em Trindade, GO. Encomende pelo WhatsApp.</p>
        <div class="hero-cta">
          <a href={WA} target="_blank" rel="noopener" class="btn btn-whatsapp">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.881 11.881 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            Encomendar pelo WhatsApp
          </a>
          <a href="#cardapio" class="btn btn-outline">Ver Cardapio</a>
        </div>
      </div>
      <div class="hero-visual">
        <div class="hero-crop">
          <div class="hero-image-placeholder">
            <span class="hero-emoji">&#127856;</span>
          </div>
        </div>
        <div class="hero-badge parallax-slow">
          <span class="badge-icon">&#9733;</span>
          <span>Receita da Mamae</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== CARDAPIO ===================== -->
  <section id="cardapio" class="section">
    <div class="container">
      <span class="eyebrow reveal-up">Nosso Cardapio</span>
      <h2 class="section-title reveal-up">Sabores que<br/><em>contam historias</em></h2>
      <p class="section-subtitle reveal-up">Cada doce carrega uma tradicao. Ingredientes selecionados, receitas de familia, preparo artesanal.</p>
      <div class="grid-3 grid-stagger stagger-group">
        {SERVICES.map(s => (
          <a href={s.href} class="card service-card" style={`--rot: ${s.rot}`}>
            <span class="service-emoji">{s.emoji}</span>
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
            <span class="service-arrow">&rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== SOBRE ===================== -->
  <section id="sobre" class="section cta-section">
    <div class="container sobre-grid">
      <div class="sobre-image parallax-slow reveal-up">
        <div class="sobre-image-inner">
          <span class="sobre-emoji">&#128149;</span>
        </div>
      </div>
      <div class="sobre-text">
        <span class="eyebrow">Nossa Historia</span>
        <h2 class="reveal-up">Da cozinha da mamae<br/>pra sua mesa</h2>
        <p class="quote-text reveal-up">A Ju dOCERIA nasceu do amor. Com as receitas da mamae, que aprendera com a avo, cada brigadeiro carrega a tradicao de geracoes.</p>
        <p class="reveal-up" style="color:var(--color-dark-text-muted);margin-top:1.5rem;line-height:1.8">Hoje em Trindade-GO, a Ju prepara cada encomenda com o mesmo cuidado de quem faz para a propria familia. Porque doce bom e doce feito com amor.</p>
        <a href="/sobre/" class="btn btn-primary reveal-up" style="margin-top:2rem">Conheca nossa historia</a>
      </div>
    </div>
  </section>

  <!-- ===================== DEPOIMENTOS ===================== -->
  <section class="section">
    <div class="container">
      <span class="eyebrow reveal-up">Depoimentos</span>
      <h2 class="section-title reveal-up">O que dizem<br/><em>sobre nos</em></h2>
      <div class="grid-3 stagger-group">
        {DEPO.map(d => (
          <div class="card depoimento-card" style={`transform:rotate(${d.rot})`}>
            <p class="quote-text">"{d.text}"</p>
            <div class="depoimento-footer">
              <strong>{d.name}</strong>
              <span>{d.city}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== COBERTURA ===================== -->
  <section class="section cta-section">
    <div class="container">
      <span class="eyebrow reveal-up">Cobertura</span>
      <h2 class="section-title reveal-up">Atendemos na<br/><em>sua regiao</em></h2>
      <div class="grid-4 stagger-group">
        <a href="/trindade/" class="card glow-border" style="text-align:center">
          <span style="font-size:1.5rem">&#128205;</span>
          <h3>Trindade</h3>
          <p style="color:var(--color-dark-text-muted);font-size:0.85rem">Principal</p>
        </a>
        <a href="/cidades/goiania/" class="card glow-border" style="text-align:center">
          <span style="font-size:1.5rem">&#128205;</span>
          <h3>Goiania</h3>
          <p style="color:var(--color-dark-text-muted);font-size:0.85rem">Delivery</p>
        </a>
        <a href="/cidades/anapolis/" class="card glow-border" style="text-align:center">
          <span style="font-size:1.5rem">&#128205;</span>
          <h3>Anapolis</h3>
          <p style="color:var(--color-dark-text-muted);font-size:0.85rem">Sob consulta</p>
        </a>
        <a href="/cidades/itumbiara/" class="card glow-border" style="text-align:center">
          <span style="font-size:1.5rem">&#128205;</span>
          <h3>Itumbiara</h3>
          <p style="color:var(--color-dark-text-muted);font-size:0.85rem">Sob consulta</p>
        </a>
      </div>
    </div>
  </section>

  <!-- ===================== FAQ ===================== -->
  <section class="section">
    <div class="container">
      <span class="eyebrow reveal-up">Perguntas Frequentes</span>
      <h2 class="section-title reveal-up">Tudo que voce<br/><em>precisa saber</em></h2>
      <div class="faq-list">
        {FAQS.map(faq => (
          <details class="faq-item reveal-up">
            <summary>{faq.q}</summary>
            <p>{faq.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== CTA FINAL ===================== -->
  <section class="section cta-section" style="text-align:center">
    <div class="container">
      <span class="eyebrow reveal-up">Vamos adocar seu dia</span>
      <h2 class="reveal-up" style="max-width:600px;margin:0 auto 1.5rem;color:var(--color-dark-text)">Pronto para<br/><em>saborear?</em></h2>
      <p class="reveal-up" style="color:var(--color-dark-text-muted);max-width:500px;margin:0 auto 2rem;font-size:1.1rem">Encomende seus doces caseiros agora. Atendimento rapido e personalizado em Trindade e regiao.</p>
      <a href={WA} target="_blank" rel="noopener" class="btn btn-whatsapp reveal-up" style="font-size:1.2rem;padding:1.25rem 3rem">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.881 11.881 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        Falar com a Ju no WhatsApp
      </a>
    </div>
  </section>

</MainLayout>

<style>
  /* ===== HERO - Feminine warm blush ===== */
  .hero {
    min-height: 100vh;
    display: flex; align-items: center;
    position: relative; overflow: hidden;
    padding-top: 6rem;
    background: linear-gradient(160deg, hsl(340, 25%, 96%) 0%, hsl(345, 35%, 93%) 50%, hsl(330, 20%, 95%) 100%);
  }
  .hero-bg-ornament {
    position: absolute; top: -20%; right: -10%;
    width: 600px; height: 600px;
    background: radial-gradient(circle, hsla(345, 50%, 80%, 0.3) 0%, transparent 70%);
    border-radius: 50%;
    pointer-events: none;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: var(--space-xl);
    align-items: center;
    position: relative; z-index: 1;
  }
  .hero-content { position: relative; z-index: 2; }
  .hero-title { margin-bottom: var(--space-lg); }
  .hero-title .word {
    display: inline-block; margin-right: 0.3em;
  }
  .hero-title em {
    color: var(--color-primary);
    font-style: italic;
  }
  .hero-subtitle {
    font-size: 1.15rem; color: var(--color-text-muted);
    max-width: 480px; margin-bottom: var(--space-xl);
    line-height: 1.7;
  }
  .hero-cta { display: flex; gap: var(--space-md); flex-wrap: wrap; }
  .hero-visual { position: relative; display: flex; justify-content: center; }
  .hero-crop {
    width: 360px; height: 420px;
    clip-path: polygon(15% 0%, 100% 0%, 85% 100%, 0% 100%);
    background: linear-gradient(145deg, var(--color-primary), var(--color-accent-alt));
    border-radius: var(--radius-lg);
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 20px 60px hsla(345, 65%, 52%, 0.15);
  }
  .hero-image-placeholder {
    text-align: center; color: white;
  }
  .hero-emoji { font-size: 6rem; }
  .hero-badge {
    position: absolute; bottom: -10px; right: -20px;
    background: white;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    padding: 0.75rem 1.25rem;
    display: flex; align-items: center; gap: 0.5rem;
    font-size: 0.85rem; font-weight: 600;
    color: var(--color-text);
    box-shadow: 0 8px 30px hsla(345, 30%, 50%, 0.1);
  }
  .badge-icon { color: var(--color-accent); }

  @media (max-width: 768px) {
    .hero-grid { grid-template-columns: 1fr; text-align: center; }
    .hero-subtitle { margin-left: auto; margin-right: auto; }
    .hero-cta { justify-content: center; }
    .hero-visual { display: none; }
  }

  /* ===== SERVICES ===== */
  .service-card { text-align: center; cursor: pointer; }
  .service-emoji { font-size: 2.5rem; display: block; margin-bottom: var(--space-sm); }
  .service-card h3 { margin-bottom: var(--space-xs); color: var(--color-text); }
  .service-card p { color: var(--color-text-muted); font-size: 0.9rem; margin-bottom: var(--space-sm); }
  .service-arrow { color: var(--color-primary); font-size: 1.2rem; font-weight: 700; }

  /* ===== SOBRE ===== */
  .sobre-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 0;
    align-items: center;
  }
  .sobre-image {
    position: relative; z-index: 1;
  }
  .sobre-image-inner {
    width: 340px; height: 400px;
    background: linear-gradient(145deg, var(--color-primary-light), var(--color-accent-alt));
    border-radius: var(--radius-lg);
    display: flex; align-items: center; justify-content: center;
    clip-path: polygon(0% 10%, 100% 0%, 100% 90%, 0% 100%);
    box-shadow: 0 20px 50px hsla(345, 65%, 52%, 0.1);
  }
  .sobre-emoji { font-size: 5rem; }
  .sobre-text {
    padding-left: var(--space-xl);
    position: relative; z-index: 2;
  }
  .sobre-text h2 { margin-bottom: var(--space-lg); color: var(--color-dark-text); }
  .sobre-text .quote-text { color: var(--color-dark-text); }
  @media (max-width: 768px) {
    .sobre-grid { grid-template-columns: 1fr; }
    .sobre-text { padding-left: 0; margin-top: var(--space-xl); text-align: center; }
    .sobre-image { display: flex; justify-content: center; }
  }

  /* ===== DEPOIMENTOS ===== */
  .depoimento-card { position: relative; }
  .depoimento-card .quote-text { font-size: 1.1rem; margin-bottom: var(--space-md); }
  .depoimento-footer strong { display: block; color: var(--color-primary); font-family: var(--font-display); }
  .depoimento-footer span { font-size: 0.85rem; color: var(--color-text-muted); }

  /* ===== FAQ ===== */
  .faq-list { max-width: 720px; }

  /* ===== CTA SECTION ===== */
  .cta-section {
    background: var(--color-dark-bg) !important;
    color: var(--color-dark-text);
  }
</style>
