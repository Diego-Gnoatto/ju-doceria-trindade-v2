---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
}
const { title, description, canonical } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <BaseHead title={title} description={description} canonical={canonical} />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>

    <!-- Footer -->
    <footer class="footer">
      <div class="container">
        <div class="footer-top">
          <div class="footer-brand">
            <span class="logo-mark">Ju</span><span class="logo-text">dOCERIA</span>
            <p>Doces caseiros com receita da mae.<br/>Trindade, GO.</p>
          </div>
          <div class="footer-links">
            <a href="/servicos/doces-caseiros/">Doces</a>
            <a href="/servicos/bolos-artesanais/">Bolos</a>
            <a href="/servicos/doces-para-festas/">Festas</a>
            <a href="/aulas/">Aulas</a>
          </div>
          <div class="footer-contact">
            <a href="https://wa.me/5562996358321" target="_blank" rel="noopener">(62) 99635-8321</a>
            <a href="mailto:tomazcristina05@gmail.com">Email</a>
            <p>Seg-Sab: 8h-18h</p>
          </div>
        </div>
        <div class="footer-bottom">
          <p>&copy; 2026 Ju dOCERIA. CNPJ 00.191.210/0001-45</p>
        </div>
      </div>
    </footer>

    <!-- WhatsApp Float -->
    <a href="https://wa.me/5562996358321?text=Oi%20Ju!%20Vi%20seu%20site%20e%20quero%20encomendar%20doces" target="_blank" rel="noopener" class="whatsapp-float" aria-label="WhatsApp">
      <svg viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.881 11.881 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
    </a>

    <!-- GSAP: load from CDN as inline scripts so Astro won't bundle/defer them -->
    <script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js"></script>
    <script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js"></script>

    <!-- GSAP Animations: runs AFTER gsap + ScrollTrigger are loaded (guaranteed order with is:inline) -->
    <script is:inline>
      // Wait for both DOM ready AND gsap available
      function initGSAP() {
        if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') {
          // Retry - scripts may still be loading
          if (initGSAP._retries < 20) {
            initGSAP._retries++;
            setTimeout(initGSAP, 100);
          }
          return;
        }
        initGSAP._retries = 0;

        gsap.registerPlugin(ScrollTrigger);

        // --- Hero animations ---
        var heroWords = document.querySelectorAll('.hero-title .word');
        if (heroWords.length) {
          gsap.from(heroWords, {
            y: 80, opacity: 0, duration: 0.8,
            stagger: 0.08, ease: 'power3.out'
          });
        }

        var heroSub = document.querySelector('.hero-subtitle');
        if (heroSub) {
          gsap.from(heroSub, {
            y: 40, opacity: 0, duration: 0.6,
            delay: 0.5, ease: 'power2.out'
          });
        }

        var heroCta = document.querySelector('.hero-cta');
        if (heroCta) {
          gsap.from(heroCta, {
            scale: 0.85, opacity: 0, duration: 0.5,
            delay: 0.8, ease: 'back.out(1.4)'
          });
        }

        var heroVisual = document.querySelector('.hero-visual');
        if (heroVisual) {
          gsap.from(heroVisual, {
            clipPath: 'inset(100% 0 0 0)', duration: 1,
            delay: 0.3, ease: 'power2.inOut'
          });
        }

        // --- Section reveals (ScrollTrigger) ---
        var reveals = document.querySelectorAll('.reveal-up');
        reveals.forEach(function(el) {
          gsap.from(el, {
            y: 60, opacity: 0, duration: 0.6,
            ease: 'power2.out',
            scrollTrigger: {
              trigger: el,
              start: 'top 85%',
              toggleActions: 'play none none none'
            }
          });
        });

        // --- Staggered cards ---
        var groups = document.querySelectorAll('.stagger-group');
        groups.forEach(function(group) {
          gsap.from(group.children, {
            y: 50, opacity: 0, duration: 0.5,
            stagger: 0.12, ease: 'power2.out',
            scrollTrigger: {
              trigger: group,
              start: 'top 80%',
              toggleActions: 'play none none none'
            }
          });
        });

        // --- Parallax ---
        var parallaxEls = document.querySelectorAll('.parallax-slow');
        parallaxEls.forEach(function(el) {
          gsap.to(el, {
            y: 60, ease: 'none',
            scrollTrigger: { trigger: el, scrub: true }
          });
        });

        // --- Testimonial rotation reset ---
        var depoCards = document.querySelectorAll('.depoimento-card');
        depoCards.forEach(function(card) {
          gsap.to(card, {
            rotation: 0, duration: 0.4,
            scrollTrigger: { trigger: card, start: 'top 90%' }
          });
        });

        // --- WhatsApp float pulse ---
        var waFloat = document.querySelector('.whatsapp-float');
        if (waFloat) {
          gsap.to(waFloat, {
            scale: 1.08, duration: 2, repeat: -1,
            yoyo: true, ease: 'power1.inOut'
          });
        }
      }
      initGSAP._retries = 0;

      // Start when DOM is ready
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initGSAP);
      } else {
        initGSAP();
      }
    </script>
  </body>
</html>

<style>
  .footer {
    background: var(--color-dark-bg);
    border-top: 1px solid hsla(340, 20%, 25%, 0.5);
    padding: var(--space-xl) 0 var(--space-lg);
    color: var(--color-dark-text);
  }
  .footer-top {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr;
    gap: var(--space-xl);
    margin-bottom: var(--space-xl);
  }
  .footer-brand { display: flex; flex-direction: column; gap: var(--space-sm); }
  .footer-brand .logo-mark {
    font-family: var(--font-display);
    font-size: 1.8rem; font-weight: 800;
    color: var(--color-primary-light); display: inline;
  }
  .footer-brand .logo-text {
    font-family: var(--font-body);
    font-size: 1rem; font-weight: 700;
    color: var(--color-dark-text); display: inline;
  }
  .footer-brand p { color: var(--color-dark-text-muted); font-size: 0.9rem; margin-top: 0.5rem; }
  .footer-links, .footer-contact {
    display: flex; flex-direction: column; gap: 0.5rem;
  }
  .footer-links a, .footer-contact a {
    color: var(--color-dark-text-muted); font-size: 0.9rem;
    transition: color 0.3s;
  }
  .footer-links a:hover, .footer-contact a:hover { color: var(--color-primary-light); }
  .footer-contact p { color: var(--color-dark-text-muted); font-size: 0.85rem; }
  .footer-bottom {
    border-top: 1px solid hsla(340, 20%, 25%, 0.5);
    padding-top: var(--space-md);
    text-align: center;
    color: var(--color-dark-text-muted); font-size: 0.8rem;
  }
  @media (max-width: 768px) {
    .footer-top { grid-template-columns: 1fr; }
  }
</style>
